{
  "name": "openmetadata-impact-github-action",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:action": "npm run build",
    "bundle:action": "npm run build && ncc build dist/action/index.js -o bundle",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.js\"",
    "typecheck": "tsc --noEmit",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "test": "npm run build && node --test test/**/*.test.js",
    "test:coverage": "npm run build && c8 --check-coverage --lines 70 --branches 55 --functions 65 --statements 70 node --test test/**/*.test.js",
    "check": "npm run lint && npm run typecheck && npm run security:audit && npm run test:coverage && npm run bundle:action"
  },
  "keywords": [],
  "author": "Ishaan2053",
  "license": "Apache-2.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@actions/core": "^2.0.3",
    "@actions/github": "^8.0.1",
    "js-yaml": "^4.1.1",
    "minimatch": "^10.2.5",
    "multi-llm-ts": "^5.1.0-beta4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.6.0",
    "@vercel/ncc": "^0.38.4",
    "c8": "^11.0.0",
    "eslint": "^9.39.4",
    "globals": "^17.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0"
  }
}
