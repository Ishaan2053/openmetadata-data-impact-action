{
  "name": "node-ts-app",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:action": "npm run build",
    "bundle:action": "npm run build && ncc build dist/action/index.js -o bundle",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.js\"",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/**/*.test.js",
    "test:coverage": "npm run build && c8 --check-coverage --lines 25 --branches 20 --functions 25 --statements 25 node --test test/**/*.test.js",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run bundle:action"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^9.1.0",
    "js-yaml": "^4.1.0",
    "minimatch": "^10.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.6.0",
    "@vercel/ncc": "^0.38.4",
    "c8": "^11.0.0",
    "eslint": "^9.39.4",
    "globals": "^17.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.2"
  }
}
